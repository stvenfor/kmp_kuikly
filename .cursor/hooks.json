{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-commit-policy.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/git-commit-policy.sh",
        "matcher": "Shell",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/git-commit-policy-shell.sh",
        "matcher": "git\\s+commit",
        "failClosed": true
      }
    ]
  }
}
